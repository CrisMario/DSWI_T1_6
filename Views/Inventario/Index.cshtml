@model IEnumerable<DSWI_T1_6.Models.Inventario>
@{
    var nombres = (Dictionary<int, string?>)ViewBag.Nombres;
}

<div class="container mt-5">
    <h1 class="text-center">Lista de inventario</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha de ingreso</th>
                <th>Cantidad</th>
                <th>Ubicación</th>
                <th>Estado</th>
                <th>Producto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InventarioId</td>
                    <td>@(item.FechaIngreso?.ToString("dd/MM/yyyy"))</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Ubicacion</td>
                    <td>@item.Estado</td>
                    <td>@nombres.GetValueOrDefault(item.ProductoId ?? 0)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.InventarioId" class="btn btn-sm btn-warning">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
